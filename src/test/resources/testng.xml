<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Selenium Automation Suite" verbose="1" parallel="methods" thread-count="3">

    <!-- Listeners -->
    <listeners>
        <listener class-name="com.automation.listeners.TestListener"/>
    </listeners>

    <!-- Smoke Tests - Run first for quick feedback -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.automation.tests.LoginTests"/>
        </classes>
    </test>

    <!-- Regression Tests - Complete test suite -->
    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.automation.tests.LoginTests"/>
        </classes>
    </test>

    <!-- Negative Tests -->
    <test name="Negative Tests">
        <groups>
            <run>
                <include name="negative"/>
            </run>
        </groups>
        <classes>
            <class name="com.automation.tests.LoginTests"/>
        </classes>
    </test>

</suite>
